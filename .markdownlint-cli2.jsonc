  "config": {
    // Line length is not enforced: specs favour readable prose and wide tables.
    "MD013": false,
    // Allow inline HTML line breaks in tables.
    "MD033": false,
    // Compact `|---|` table delimiters are fine.
    "MD060": false
  },
